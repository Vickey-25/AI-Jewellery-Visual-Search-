# Copy to .env and edit. Never commit .env.
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/jewellery_ai

MODEL_NAME=ViT-B-32
MODEL_PRETRAINED=laion2b_s34b_b79k
MODEL_DEVICE=cpu
# TORCH_NUM_THREADS=4

FAISS_INDEX_PATH=./data/index/jewellery.index
FAISS_MAPPING_PATH=./data/index/id_mapping.json
IMAGES_DIR=./data/images

MAX_IMAGE_SIZE_MB=5
MAX_SEARCH_IMAGE_WIDTH=4096
MAX_SEARCH_IMAGE_HEIGHT=4096

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Hybrid search ranking weights (normalised automatically)
HYBRID_IMAGE_WEIGHT=0.6
HYBRID_TEXT_WEIGHT=0.4

# Calibrated visual search similarity threshold (0.80)
VISUAL_SEARCH_SIMILARITY_THRESHOLD=0.80

LOG_LEVEL=INFO

# Used by the React app (copy to web/.env)
VITE_API_URL=http://127.0.0.1:8000
